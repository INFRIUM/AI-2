# ==================================================
# INFRIUM AI-2 | Python .gitignore
# ==================================================

# Python 캐시
__pycache__/
*.py[cod]
*$py.class

# Python 가상환경
.venv/
venv/
env/
ENV/

# 환경변수 및 비밀정보
.env
.env.*
!.env.example

# IDE 설정
.vscode/
.idea/
*.swp
*.swo

# 운영체제 파일
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini

# Jupyter
.ipynb_checkpoints/

# 테스트 및 정적 분석 캐시
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# 빌드 파일
build/
dist/
*.egg-info/

# 로그 및 임시 파일
*.log
logs/
*.tmp
*.temp
*.bak

# ==================================================
# INFRIUM AI-2 데이터 관리
# ==================================================

# 원본 센서 데이터
data/raw/

# 전처리 및 실험용 데이터
data/processed/

# 개인 또는 비공개 데이터
data/private/

# ==================================================
# INFRIUM AI-2 모델 및 결과 관리
# ==================================================

# models/ 폴더는 GitHub에서 관리
# results/ 폴더는 GitHub에서 관리

# 대용량 임시 실험 파일
checkpoints/
wandb/
mlruns/

# AI-1에서 전달받은 실험 데이터 압축파일
data/*.zip
# 개인 참고용 문서 (GitHub 업로드 금지)
docs/INFRIUM_PROJECT_API_GUIDE.md
